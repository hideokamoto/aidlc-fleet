{
  "name": "aidlc-fleet-cli",
  "version": "0.1.0",
  "description": "aidlc-fleet distribution CLI — declares an engine version and plugin set in one central channel file, and syncs projects to it via update/check.",
  "type": "module",
  "private": true,
  "bin": {
    "aidlc-fleet": "./bin/aidlc-fleet.ts"
  },
  "scripts": {
    "test": "bun test src/",
    "test:coverage": "bun test --coverage src/",
    "build": "bun build ./bin/aidlc-fleet.ts --outdir ./dist --target bun",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
